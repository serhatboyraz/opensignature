{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=opensignature;Username=esign;Password=esign"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "User": "esign",
    "Pass": "esign",
    "VHost": "/",
    "ClientProvidedName": "opensignature-api"
  },
  "Outbox": {
    "PollInterval": "00:00:01",
    "BatchSize": 50,
    "MaxRetries": 5
  },
  "Storage": {
    "Local": {
      "RootPath": "./data/storage"
    }
  },
  "Signatures": {
    "DefaultTenantId": "tenant-demo",
    "MaxUploadBytes": 26214400
  },
  "Authentication": {
    "Enabled": false,
    "ApiKeys": []
  },
  "Secrets": {
    "Values": {}
  },
  "Signing": {
    "AllowExpiredCertificates": false,
    "Pfx": {
      "ProviderId": "pfx-dev",
      "Name": "Development PFX Provider",
      "Path": "./data/certs/dev.pfx"
    },
    "SmartCard": {
      "ProviderId": "usb-token",
      "Name": "USB Token / Smart Card",
      "ModulePath": "",
      "AutoDetect": false,
      "PreferFirstSlotWhenAmbiguous": false,
      "PinSecretName": "Signing:SmartCard:Pin"
    }
  }
}
