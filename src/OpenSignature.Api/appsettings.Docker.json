{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=postgres;Port=5432;Database=opensignature;Username=esign;Password=esign"
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Port": 5672,
    "User": "esign",
    "Pass": "esign",
    "VHost": "/",
    "ClientProvidedName": "opensignature-api"
  },
  "Storage": {
    "Local": {
      "RootPath": "/data/storage"
    }
  },
  "Signing": {
    "AllowExpiredCertificates": true,
    "Pfx": {
      "ProviderId": "pfx-dev",
      "Name": "Development PFX Provider",
      "Path": "/data/certs/dev.pfx",
      "PasswordSecretName": "Signing:Pfx:Password"
    },
    "SmartCard": {
      "AutoDetect": false,
      "ModulePath": ""
    }
  },
  "Authentication": {
    "Enabled": false
  }
}
