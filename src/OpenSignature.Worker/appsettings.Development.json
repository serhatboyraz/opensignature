{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5433;Database=opensignature;Username=esign;Password=esign"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "User": "esign",
    "Pass": "esign",
    "VHost": "/",
    "ClientProvidedName": "opensignature-worker-dev"
  },
  "SigningJobRetry": {
    "MaxAttempts": 5,
    "InitialBackoffMilliseconds": 1000,
    "BackoffMultiplier": 2.0,
    "MaxBackoffMilliseconds": 60000
  },
  "Storage": {
    "Local": {
      "RootPath": "./data/storage"
    }
  },
  "Secrets": {
    "Values": {}
  },
  "Signing": {
    "AllowExpiredCertificates": true,
    "Pfx": {
      "ProviderId": "pfx-dev",
      "Name": "Development PFX Provider",
      "Path": "./data/certs/dev.pfx"
    },
    "SmartCard": {
      "ProviderId": "usb-token",
      "Name": "USB Token / Smart Card",
      "ModulePath": "C:\\Windows\\System32\\eTPKCS11.dll",
      "AutoDetect": false,
      "PreferFirstSlotWhenAmbiguous": true,
      "PinSecretName": "Signing:SmartCard:Pin"
    }
  },
  "Timestamping": {
    "Url": "",
    "PolicyOid": ""
  }
}
