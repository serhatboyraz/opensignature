{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=opensignature;Username=esign;Password=esign"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "User": "esign",
    "Pass": "esign",
    "VHost": "/",
    "ClientProvidedName": "opensignature-worker"
  },
  "SigningJobRetry": {
    "MaxAttempts": 5,
    "InitialBackoffMilliseconds": 1000,
    "BackoffMultiplier": 2.0,
    "MaxBackoffMilliseconds": 60000
  },
  "Storage": {
    "Local": {
      "RootPath": "./data/storage"
    }
  },
  "Signing": {
    "Pfx": {
      "ProviderId": "pfx-dev",
      "Name": "Development PFX Provider",
      "Path": "./data/certs/dev.pfx"
    }
  }
}
