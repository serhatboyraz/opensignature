# OpenSignature API base URL (no trailing slash).
# Leave empty in local Vite to use the /api proxy (avoids CORS).
# Proxy target defaults to http://localhost:5270 (Api "http" profile).
# Override proxy with VITE_PROXY_TARGET=https://localhost:7010 for the https profile.
VITE_API_BASE_URL=

# Optional request headers forwarded by the API client
VITE_TENANT_ID=tenant-demo
VITE_API_KEY=
