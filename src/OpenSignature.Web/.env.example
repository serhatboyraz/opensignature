# OpenSignature API base URL (no trailing slash).
# Default when unset: https://localhost:7010 (Api launchSettings "https" profile).
# Leave empty in local Vite to use the /api proxy (avoids CORS and self-signed cert friction).
VITE_API_BASE_URL=

# Optional request headers forwarded by the API client
VITE_TENANT_ID=tenant-demo
VITE_API_KEY=
