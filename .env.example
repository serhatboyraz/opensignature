# OpenSignature local Docker Compose
# Copy to .env and adjust if needed. Do not commit real production secrets.

# PostgreSQL
POSTGRES_DB=opensignature
POSTGRES_USER=esign
POSTGRES_PASSWORD=esign
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_DEFAULT_USER=esign
RABBITMQ_DEFAULT_PASS=esign
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Application ports (host → container)
API_PORT=5270
WEB_PORT=5173
IMAGE_TAG=local

# Development PFX (generated by pfx-init; demo only — change for shared environments)
PFX_PASSWORD=opensignature-dev

# Optional RFC 3161 TSA (Worker). Leave empty for Baseline-B only.
TIMESTAMPING_URL=
TIMESTAMPING_USERNAME=
TIMESTAMPING_PASSWORD=

# Web build-time (empty = same-origin /api via nginx proxy)
VITE_API_BASE_URL=
VITE_TENANT_ID=tenant-demo
